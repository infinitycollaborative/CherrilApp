# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables fully deleting an auth user from the admin panel and the
# account-deletion flow. Copy from Project Settings → API → service_role.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
