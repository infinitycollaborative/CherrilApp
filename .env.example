# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — optional. When set, the Content Generation Studio and Research
# Assistant call Claude for real drafts. When unset, the app falls back to
# high-quality on-brand templates so every flow still works end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
